{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "autoreconf",
			"type": "shell",
			"command": "autoreconf",
			"args": ["-if"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "configure",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"mkdir -p build && cd build && ../configure --enable-cxxmph"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"dependsOn": ["autoreconf"]
		},
		{
			"label": "configure-check",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"CHECK_PREFIX=$HOME/.local/share/mise/installs/github-libcheck-check/0.10.0/_prefix && mkdir -p build && cd build && CPPFLAGS=\"-I$CHECK_PREFIX/include $CPPFLAGS\" LDFLAGS=\"-L$CHECK_PREFIX/lib $LDFLAGS\" PKG_CONFIG_PATH=$CHECK_PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH ../configure --enable-cxxmph --enable-check"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"dependsOn": ["autoreconf"]
		},
		{
			"label": "build",
			"type": "shell",
			"command": "make",
			"args": ["-j4"],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": ["$gcc"],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": ["configure"]
		},
		{
			"label": "test",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"make -j4 && make check"
			],
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"problemMatcher": ["$gcc"],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"dependsOn": ["configure-check"]
		},
		{
			"label": "clean",
			"type": "shell",
			"command": "rm",
			"args": ["-rf", "build"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}
